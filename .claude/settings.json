{
  "permissions": {
    "deny": [
      "Edit(data/raw/**)",
      "Write(data/raw/**)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-raw.sh"
          }
        ]
      }
    ]
  }
}